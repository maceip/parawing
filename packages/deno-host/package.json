{
  "name": "@parawing/deno-host",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Standalone Node/Deno host running Parawing isolates in zero-permission Deno subprocesses.",
  "exports": {
    ".": "./src/server.ts",
    "./deno-isolate-loader": "./src/deno-isolate-loader.ts",
    "./file-assets": "./src/file-assets.ts",
    "./minimal-outbound": "./src/minimal-outbound.ts",
    "./otlp-tracer": "./src/otlp-tracer.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.ts",
    "types": "tsc --noEmit && tsc --noEmit -p tsconfig.bundle.json"
  },
  "dependencies": {
    "@parawing/engine": "workspace:*",
    "@parawing/jsrpc-types": "workspace:*",
    "@parawing/rpc-transport": "workspace:*",
    "devtools-protocol": "^0.0.1669207",
    "es-module-lexer": "^2.1.0",
    "hono": "^4.13.12",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "esbuild": "^0.27.0",
    "typescript": "^5.6.0"
  }
}
