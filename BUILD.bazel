load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary", "js_test")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

exports_files([
    "VERSION",
    "clippy.toml",
    "package.json",
    "pnpm-workspace.yaml",
    "rustfmt.toml",
])

copy_to_bin(
    name = "wpt_expectations",
    srcs = ["tests/wpt-expectations.json"],
    visibility = ["//visibility:public"],
)

copy_to_bin(
    name = "module_bazel",
    srcs = ["MODULE.bazel"],
    visibility = ["//scripts:__pkg__"],
)

copy_to_bin(
    name = "oxlintrc",
    srcs = [".oxlintrc.json"],
    visibility = ["//scripts:__pkg__"],
)

copy_to_bin(
    name = "wpt_revision",
    srcs = ["tests/wpt-revision.json"],
    visibility = ["//scripts:__pkg__", "//tests/wpt:__pkg__"],
)

copy_to_bin(
    name = "wpt_tests",
    srcs = ["tests/wpt-tests.json"],
    visibility = ["//scripts:__pkg__"],
)

copy_to_bin(
    name = "pw_expectations",
    srcs = ["tests/pw-expectations.json"],
    visibility = ["//scripts:__pkg__"],
)

copy_to_bin(
    name = "pw_tests",
    srcs = ["tests/pw-tests.json"],
    visibility = ["//scripts:__pkg__"],
)

copy_to_bin(
    name = "pptr_expectations",
    srcs = ["tests/pptr-expectations.json"],
    visibility = ["//scripts:__pkg__"],
)

copy_to_bin(
    name = "pptr_tests",
    srcs = ["tests/pptr-tests.json"],
    visibility = ["//scripts:__pkg__"],
)

_CONFIG_PACKAGES = [
    "packages/core/pkg",
    "packages/deno-host",
    "packages/device-authority",
    "packages/dom-shim",
    "packages/engine",
    "packages/engine/test/e2e",
    "packages/jsrpc-types",
    "packages/parawing-cli",
    "packages/page-renderer",
    "packages/page-script",
    "packages/rpc-transport",
    "packages/rust-host",
    "packages/script-gate",
    "packages/worker-script",
]

js_library(
    name = "workspace_configs",
    srcs = glob(
        ["**/package.json", "**/tsconfig*.json"],
        allow_empty = True,
        exclude = [
            "**/dist/**",
            ".*/**",
            "bazel-*/**",
            "vendor/**",
        ],
    ),
    deps = [
        "//%s:workspace_configs" % path
        for path in _CONFIG_PACKAGES
    ] + ["//scripts:workspace_configs"],
)

_TRACKED_FILES_ENV = {"PARAWING_TRACKED_FILES": "$(rootpath @tracked_files//:files)"}

js_test(
    name = "no_dts_test",
    size = "small",
    data = [
        "@tracked_files//:files",
        "//scripts:tracked_files",
    ],
    entry_point = "//scripts:check_no_dts",
    env = _TRACKED_FILES_ENV,
)

js_test(
    name = "ts_coverage_test",
    size = "small",
    data = [
        ":node_modules/typescript",
        ":workspace_configs",
        "@tracked_files//:files",
        "//scripts:tracked_files",
    ],
    entry_point = "//scripts:check_ts_coverage",
    env = _TRACKED_FILES_ENV,
)

js_test(
    name = "lockfile_test",
    size = "small",
    data = [
        ".npmrc",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        ":workspace_configs",
        "@pnpm",
        "@tracked_files//:files",
        "//scripts:tracked_files",
    ],
    entry_point = "//scripts:lockfile_check",
    env = _TRACKED_FILES_ENV | {"PNPM_BIN": "$(rootpath @pnpm)"},
)

js_test(
    name = "cargo_lock_test",
    size = "small",
    copy_data_to_bin = False,
    data = [
        "Cargo.lock",
        "Cargo.toml",
        "//packages/core:Cargo.toml",
        "//packages/renderer-core:Cargo.toml",
        "//packages/scene-host-wasm:Cargo.toml",
        "@cargo_vendor//:vendor",
        "@cargo_vendor//:vendor.json",
        "@rules_rust//rust/toolchain:current_cargo_files",
        "@rules_rust//rust/toolchain:current_rustc_files",
        "@rules_rust//rust/toolchain:current_rustc_lib_files",
    ],
    entry_point = "//scripts:cargo_lock_check",
    env = {
        "CARGO": "$(rootpath @rules_rust//rust/toolchain:current_cargo_files)",
        "CARGO_VENDOR_INDEX": "$(rootpath @cargo_vendor//:vendor.json)",
        "RUSTC": "$(rootpath @rules_rust//rust/toolchain:current_rustc_files)",
    },
)

_DEPS_INPUTS = [
    "Cargo.lock",
    "Cargo.toml",
    "MODULE.bazel",
    "VERSION",
    "package.json",
    "pnpm-lock.yaml",
    "//bazel/rust:rules_rust-patched-crates.patch",
    "//bazel/rust:rules_rust-proc-macro-no-strip.patch",
    "//packages/core:BUILD.bazel",
    "//packages/device-authority:Cargo.lock",
    "//packages/parawing-cli:Cargo.lock",
    "//packages/rust-host:BUILD.bazel",
    "//packages/rust-host:Cargo.lock",
    "//packages/rust-host:Cargo.toml",
    "//scripts:deps_lib",
    "//scripts:patches_tree",
    "//scripts/lint/rust-check:Cargo.lock",
    "//scripts/memprof-rewriter:Cargo.lock",
] + glob(["deps/*.json"])

js_test(
    name = "deps_check",
    size = "small",
    args = ["verify"],
    copy_data_to_bin = False,
    data = _DEPS_INPUTS,
    entry_point = "//scripts:deps_check_entry",
)

js_run_binary(
    name = "deps_report",
    srcs = _DEPS_INPUTS,
    outs = [
        "parawing.openvex.json",
        "parawing-deps-report.json",
        "parawing-deps-report.md",
    ],
    args = [
        "report",
        "--vex-out",
        "$(rootpath parawing.openvex.json)",
        "--json-out",
        "$(rootpath parawing-deps-report.json)",
        "--md-out",
        "$(rootpath parawing-deps-report.md)",
    ],
    copy_srcs_to_bin = False,
    mnemonic = "ParawingDepsReport",
    progress_message = "Generating deterministic OpenVEX and dependency integrity reports",
    tool = "//scripts:deps",
    visibility = ["//visibility:public"],
)

test_suite(
    name = "check",
    tests = [
        ":cargo_lock_test",
        ":deps_check",
        ":lockfile_test",
        ":no_dts_test",
        ":ts_coverage_test",
        "//packages/core/pkg:memprof_build",
        "//packages/deno-host:build",
        "//packages/deno-host:test",
        "//packages/deno-host:types",
        "//packages/deno-host:types_bundle",
        "//packages/device-authority:lib_test",
        "//packages/dom-shim:build",
        "//packages/dom-shim:no_explicit_any",
        "//packages/dom-shim:types",
        "//packages/engine:types",
        "//packages/engine:types_e2e",
        "//packages/engine:types_e2e_demos",
        "//packages/engine:types_fixtures_worker",
        "//packages/jsrpc-types:types",
        "//packages/page-renderer:build",
        "//packages/page-renderer:types",
        "//packages/page-script:build",
        "//packages/page-script:types",
        "//packages/rpc-transport:test",
        "//packages/rpc-transport:types",
        "//packages/rust-host:bin_build",
        "//packages/rust-host:host_test",
        "//packages/scene-host-wasm:abi_test",
        "//packages/script-gate:test",
        "//packages/script-gate:types",
        "//packages/worker-script:build",
        "//packages/worker-script:types",
        "//packages/worker-script:types_strict",
        "//scripts:helpers_test",
        "//scripts:lint_test",
        "//scripts:lint_types",
    ],
)

# The Rust lint gates: clippy, rustfmt, control-flow nesting and the comment policy over every
# package's Rust sources. CI runs `bazel test //:rust_lint`; they need no cargo install.
