# Bazel credential helper for --config=limrun, --config=limrun_macos, and --config=limrun_cache.
# Reads LIM_API_KEY from the environment or local user dotenv files; no secrets live in git.
set -euo pipefail

export PATH="${PATH:+$PATH:}/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:${HOME:-}/.local/bin"
if [[ -n "${HOME:-}" && -d "${HOME}/.nvm/versions/node" ]]; then
  latest_nvm_bin="$(ls -1d "${HOME}"/.nvm/versions/node/*/bin 2>/dev/null | tail -n 1 || true)"
  if [[ -n "${latest_nvm_bin}" ]]; then
    export PATH="${latest_nvm_bin}:${PATH}"
  fi
fi

read_dotenv_key() {
  local file="$1"
  [[ -f "$file" ]] || return 1
  local val
  val="$(
    sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}LIM_API_KEY[[:space:]]*=[[:space:]]*//p' "$file" \
      | tail -n 1 \
      | sed -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//"
  )"
  [[ -n "$val" ]] || return 1
  printf '%s' "$val"
}

if [[ -z "${LIM_API_KEY:-}" ]]; then
  repo_root="$(cd "$(dirname "$0")/../.." && pwd)"
  for candidate in \
    "${repo_root}/.limrun.env" \
    "${HOME:-}/.config/limrun/env" \
    "${HOME:-}/trap/.env"; do
    if key="$(read_dotenv_key "$candidate")"; then
      export LIM_API_KEY="$key"
      break
    fi
  done
fi

if [[ -z "${LIM_API_KEY:-}" && -s "${HOME:-}/.gemini/lim/config.yaml" && ! -s "${HOME:-}/.lim/config.yaml" ]]; then
  mkdir -p "${HOME}/.lim"
  ln -sfn "${HOME}/.gemini/lim/config.yaml" "${HOME}/.lim/config.yaml"
fi

command -v lim-bazel-credentials >/dev/null 2>&1 || {
  echo "limrun: lim-bazel-credentials not found on PATH (install with: npm install -g lim)" >&2
  exit 1
}

exec lim-bazel-credentials "$@"
